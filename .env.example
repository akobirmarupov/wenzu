# ============================================================
# WENZU — muhit sozlamalari namunasi
# Bu faylni `.env` deb nusxalab, qiymatlarni to'ldiring.
# `.env` HECH QACHON git'ga qo'shilmasin.
# ============================================================

# --- Asosiy ---
# Yangi kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=bu-yerga-tasodifiy-uzun-kalit
DEBUG=False
ALLOWED_HOSTS=api.wenzu.uz,wenzu.uz
LOG_LEVEL=INFO

# --- Ma'lumotlar bazasi ---
DB_NAME=wenzu_db
DB_USER=wenzu_user
DB_PASSWORD=kuchli-parol
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (kesh, sessiya, Celery broker) ---
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# --- CORS / CSRF (mobil ilova va veb-frontend domenlari) ---
CORS_ALLOWED_ORIGINS=https://wenzu.uz,https://app.wenzu.uz
CSRF_TRUSTED_ORIGINS=https://wenzu.uz,https://api.wenzu.uz

# --- HTTPS ---
SECURE_SSL_REDIRECT=True

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Biznes qoidalari ---
TRIAL_DAYS=7
SUBSCRIPTION_DAYS=30

# --- Kesh muddati (sekund) ---
CACHE_TTL_BUSINESS_LIST=60
CACHE_TTL_BUSINESS_DETAIL=120

# --- Google orqali kirish (MAJBURIY) ---
#
# Ro'yxatdan o'tishning yagona yo'li. Olish:
#   1. console.cloud.google.com → loyiha tanlang/yarating
#   2. APIs & Services → OAuth consent screen → External → to'ldiring
#   3. APIs & Services → Credentials → Create credentials
#      → OAuth client ID → Application type: Web application
#   4. Authorized JavaScript origins:
#        http://127.0.0.1:8000   (lokal ishlab chiqish)
#        https://wenzu.uz        (production)
#   5. Chiqqan "Client ID" ni shu yerga qo'ying.
#
# Bu qiymat maxfiy emas — u brauzerga ham boradi. `client secret`
# kerak emas.
GOOGLE_CLIENT_ID=
# Client secret: o'sha sahifada "Client secrets" → Add secret.
# Ko'rsatilgan qiymatni darhol nusxalang — Google uni ikkinchi marta
# ko'rsatmaydi.
GOOGLE_CLIENT_SECRET=

# --- Telegram bot (adminni xabardor qilish) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- S3-mos ombor (MinIO / AWS) — production uchun ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# --- AI (ixtiyoriy) ---
GEMINI_API_KEY=
