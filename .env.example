# ============================================================
# FEASTO — muhit sozlamalari namunasi
# Bu faylni `.env` deb nusxalab, qiymatlarni to'ldiring.
# `.env` HECH QACHON git'ga qo'shilmasin.
# ============================================================

# --- Asosiy ---
# Yangi kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=bu-yerga-tasodifiy-uzun-kalit
DEBUG=False
# BO'SH QOLDIRMANG: DEBUG=False bilan bo'sh ALLOWED_HOSTS sayt har bir
# so'rovga 400 qaytarishiga olib keladi. Shuning uchun bunday sozlamada
# ilova umuman ko'tarilmaydi va aniq xato beradi.
ALLOWED_HOSTS=feasto.uz,www.feasto.uz

# Fayl logining darajasi (logs/feasto.log — 10 MB da aylanadi).
LOG_LEVEL=INFO
# Konsol (stdout → journald/Docker) darajasi. Productionda standart
# qiymat WARNING: u yerdagi log hech qanday chegarasiz o'sadi va
# INFO oqimi diskni to'ldirib qo'yishi mumkin. Nosozlikni qidirayotgan
# bo'lsangiz vaqtincha INFO qiling.
CONSOLE_LOG_LEVEL=WARNING

# --- Ma'lumotlar bazasi ---
DB_NAME=feasto_db
DB_USER=feasto_user
DB_PASSWORD=kuchli-parol
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (kesh, sessiya, Celery broker) ---
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# --- CORS / CSRF (mobil ilova va veb-frontend domenlari) ---
# API alohida subdomenda emas, o'sha domen ostida (/api/) — shuning
# uchun CORS bo'sh qolsa ham bo'ladi. Mobil ilova qo'shilganda
# uning manzili shu yerga yoziladi.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://feasto.uz,https://www.feasto.uz

# --- HTTPS ---
SECURE_SSL_REDIRECT=True

# Proksi (nginx / Cloudflare) orqasida ishlaganda haqiqiy sxemani
# `X-Forwarded-Proto` dan olish. Productionda o'zi yoqiladi;
# DEBUG=True bilan tunnel orqali sinaganda qo'lda True qiling.
USE_PROXY_SSL_HEADER=

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Biznes qoidalari ---
TRIAL_DAYS=7
SUBSCRIPTION_DAYS=30

# --- Kesh muddati (sekund) ---
CACHE_TTL_BUSINESS_LIST=60
CACHE_TTL_BUSINESS_DETAIL=120

# --- Google orqali kirish (MAJBURIY) ---
#
# Ro'yxatdan o'tishning yagona yo'li. Olish:
#   1. console.cloud.google.com → loyiha tanlang/yarating
#   2. APIs & Services → OAuth consent screen → External → to'ldiring
#   3. APIs & Services → Credentials → Create credentials
#      → OAuth client ID → Application type: Web application
#   4. Authorized JavaScript origins:
#        http://127.0.0.1:8000   (lokal ishlab chiqish)
#        https://feasto.uz       (production)
#   5. Authorized redirect URIs — IKKALASI ham qo'shilsin:
#        http://127.0.0.1:8000/api/auth/google/callback/
#        https://feasto.uz/api/auth/google/callback/
#      Google ICHKI TARMOQ manzillarini (192.168.x.x) qabul qilmaydi —
#      telefonda sinash uchun domen yoki tunnel kerak.
#   6. Chiqqan "Client ID" ni shu yerga qo'ying.
#
# Bu qiymat maxfiy emas — u brauzerga ham boradi. `client secret`
# kerak emas.
GOOGLE_CLIENT_ID=
# Client secret: o'sha sahifada "Client secrets" → Add secret.
# Ko'rsatilgan qiymatni darhol nusxalang — Google uni ikkinchi marta
# ko'rsatmaydi.
GOOGLE_CLIENT_SECRET=

# --- S3-mos ombor (MinIO / AWS) — production uchun ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# --- AI (ixtiyoriy) ---
GEMINI_API_KEY=
